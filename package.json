{
  "name": "s2j-source-list",
  "version": "2.0.12",
  "description": "Using SwiftUI, reimplementing the AppKit-based \"PXSourceList\".",
  "type": "module",
  "author": "Koutarou ISHIKAWA",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stein2nd/s2j-source-list.git"
  },
  "homepage": "https://github.com/stein2nd/s2j-source-list#readme",
  "bugs": {
    "url": "https://github.com/stein2nd/s2j-source-list/issues"
  },
  "keywords": [
    "SwiftUI",
    "AppKit",
    "Source List"
  ],
  "directories": {
    "doc": "docs"
  },
  "files": [
    "README.md",
    "COMMON_SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/*.md ./docs/**/*.md",

    "lint:swift": "npm run xcode:generate && npm run lint:swiftlint && npm run lint:swiftformat && npm run lint:periphery",
    "lint:swiftlint": "swiftlint lint --strict Sources Tests Package.swift",
    "lint:swiftformat": "swiftformat --lint .",
    "lint:periphery": "xcodegen generate && periphery scan --strict",
    "xcode:generate": "xcodegen generate",
    "format:swift": "swiftformat .",
    "profile:swift": "xcrun xctrace",

    "lint:build": "xcodegen generate && xcodebuild build -project S2JSourceList.xcodeproj -scheme S2JSourceList-macOS -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO",
    "analyze:swift": "xcodegen generate && xcodebuild analyze -project S2JSourceList.xcodeproj -scheme S2JSourceList-macOS -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO",

    "test:local": "./scripts/test-local.sh",
    "test:local:iOSfull": "./scripts/test-local.sh --ios-device \"iPad Pro\" --ios-version \"17.6\" --enable-xcode-project --xcodegen-auto-install"
  },
  "devDependencies": {
    "@s2j/docs-linter": "^1.0.32"
  },
  "allowScripts": {
    "@s2j/docs-linter": true
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
